        "@types/source-map-support": "^0.5.10",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/parser": "^8.71.2",
        "concurrently": "^10.0.6",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.12.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
