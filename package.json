        "chalk": "^6.0.1",
        "cookie-parser": "^1.4.7",
        "data-uri-to-buffer": "^8.0.0",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "express-handlebars": "^9.0.2",
        "format-duration": "^4.0.0",
        "node-widevine": "^0.1.3",
        "parse-hls": "^1.0.7",
        "pretty-bytes": "^7.2.0",
        "pssh-tools": "^1.2.0",
        "source-map-support": "^0.5.21",
        "swagger-ui-express": "^5.0.1",
        "timeago.js": "^4.0.2",
        "toml": "^5.0.1",
        "undici": "^8.12.2",
